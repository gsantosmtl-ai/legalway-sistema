# Entrada automática de leads: formulário do Facebook/Instagram e WhatsApp.
# As duas coisas usam o MESMO aplicativo da Meta e o MESMO endereço de webhook:
#   https://SEU-ENDERECO/api/publico/meta/leads
# Estas variáveis vão no painel do Railway, não neste arquivo.

# ---- comum aos dois canais ----
# Frase que VOCÊ inventa. A mesma vai no painel da Meta ao cadastrar o webhook.
META_VERIFY_TOKEN=
# "Chave Secreta do App" em developers.facebook.com > seu app > Config. > Básico.
# É com ela que o servidor confere que o aviso veio mesmo da Meta.
META_APP_SECRET=

# ---- formulário instantâneo (Lead Ads) ----
# Token da Página com permissão leads_retrieval, de longa duração.
META_PAGE_TOKEN=
# Opcional: diz qual serviço cada formulário representa, para o lead já nascer
# com o tipo de visto certo. O número é o ID do formulário instantâneo.
# {"120246905579880711":{"servico":"EB-2 NIW"},"999":{"servico":"Visto T"}}
META_FORMULARIOS=

# ---- WhatsApp oficial (Cloud API) ----
# Token com permissão whatsapp_business_messaging.
WHATSAPP_TOKEN=
# ID do número, no painel do WhatsApp dentro do app.
WHATSAPP_PHONE_ID=

# ---- opcional ----
# Em quantos dias a mesma pessoa ainda é "o mesmo lead". Fora disso, o sistema
# entende como oportunidade nova. Padrão: 90.
JANELA_LEAD_REPETIDO_DIAS=
