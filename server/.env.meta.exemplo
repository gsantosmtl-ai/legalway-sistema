# Entrada automática de leads do Facebook e do Instagram.
# Estas quatro variáveis vão no painel do Railway, não neste arquivo.

# 1. Uma frase que VOCÊ inventa. A mesma vai no painel da Meta, ao cadastrar o
#    endereço do webhook. Serve só para a Meta provar que o endereço é seu.
META_VERIFY_TOKEN=

# 2. "Chave Secreta do App", em developers.facebook.com > seu app >
#    Configurações > Básico. É com ela que o servidor confere que o aviso veio
#    mesmo da Meta. Sem ela, o webhook recusa tudo — de propósito.
META_APP_SECRET=

# 3. Token da Página com permissão leads_retrieval. Gerado na Graph API Explorer
#    e trocado por um token de longa duração.
META_PAGE_TOKEN=

# 4. Opcional: diz qual serviço cada formulário representa, para o lead já nascer
#    com o tipo de visto certo. O número é o ID do formulário instantâneo.
#    {"120246905579880711":{"servico":"EB-2 NIW"},"999":{"servico":"Visto T"}}
META_FORMULARIOS=
