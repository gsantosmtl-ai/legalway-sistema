# Copie pra .env pra rodar local. No Railway essas variáveis vêm do painel.
DATABASE_URL=postgres://legalway:legalway@localhost:5434/legalway
PORT=3020
# Opcional: senha inicial da Tatiane (admin). Se vazio, gera uma aleatória e mostra no log na 1ª inicialização.
SENHA_INICIAL_ADMIN=
# E-mail enviado pelo servidor (cópia do contrato assinado pro cliente). Deixe vazio pra desligar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_DE=Legal Way Group <contato@legalway.group>

# WAHA — o WhatsApp dos setores (documentação, financeiro, comercial).
# Não é o WhatsApp Business oficial: é sessão de WhatsApp Web, então manda
# texto livre a qualquer hora, sem a janela de 24 h e sem modelo aprovado.
# O nome da sessão de cada setor fica em Configurações → Regras → Setores.
WAHA_URL=
WAHA_API_KEY=
