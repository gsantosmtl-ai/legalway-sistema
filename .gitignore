node_modules/
.env
.DS_Store

# configuração das ferramentas (tem senha dentro)
ferramentas/config

# resultado e estado da importação do Kommo (dado de cliente)
ferramentas/.kommo-importado.json
ferramentas/importar-no-sistema.json
ferramentas/planilhas/

# arquivos de importação gerados (têm documento de cliente em base64)
# O repositório é público. Nada de cliente pode entrar aqui — nem o documento,
# nem a lista de nomes. Na noite de 11/10 as 26 fatias da leva 2 do Drive
# (175 MB de PDF de cliente) chegaram a ser commitadas; o commit não tinha
# sido enviado e foi reescrito antes de sair.
ferramentas/importar-*.json
ferramentas/trello-lote*.json
ferramentas/saida-*/
# saída do religar-parcelas.cjs: 122 parcelas com NOME, serviço, valor e
# vencimento. Estava versionada desde 11/10 — a própria regra acima diz que
# lista de nome não entra. O arquivo continua no disco e o script o refaz;
# auditar-trello.cjs já segue sem ele quando falta.
ferramentas/religar-parcelas.json
ferramentas/drive-metadados.json
ferramentas/drive-registros.json
ferramentas/estado-atual.json
ferramentas/anexos-*.json
ferramentas/drive-grandes-pendentes.txt

# Plano da virada: é documento de trabalho e cita cliente pelo nome.
# Fica no computador dela, não no repositório público.
ferramentas/PLANO-VIRADA-13-10.md

# Auditoria: scripts versionados, resultados não (têm dado de cliente)
ferramentas/auditoria/relatorios/
ferramentas/auditoria/*.json
ferramentas/auditoria/instantaneo/

ferramentas/auditoria/CHECKPOINT.md

# Scripts de uma vez só, escritos durante uma conversa para rodar na produção.
# Levam nome de cliente, consulta de usuário e e-mail dentro. O repositório é
# PÚBLICO: um `git add -A` distraído publicaria isso.
ferramentas/.tmp-*
